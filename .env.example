# =========================================================================
# KrishiMitra (AgriSmart AI) - Fullstack Environment Configuration
# =========================================================================

# --- Frontend Settings (Vite / React) ---
# Backend API Base URL for frontend clients:
VITE_API_URL=http://localhost:8000
# Google Maps JavaScript API Key (Optional):
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Backend Server Settings (FastAPI) ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# --- Google Gemini AI API Key ---
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Machine Learning Model Paths ---
DISEASE_MODEL_PATH=saved_models/disease_models/crop_disease_model.keras
PEST_MODEL_PATH=saved_models/pest_models/pest_model.keras
CROP_MODEL_PATH=saved_models/crop_models/crop_classifier_model.keras
YIELD_MODEL_PATH=saved_models/yield_models/crop_yield_model.pkl
